{
  "name": "DataProductPublicationWorkflow",
  "displayName": "Data Product Publication",
  "description": "Publish an unpublished View as a Data Product. Approval records the asset as Granted in OpenMetadata; Oracle policy changes are not performed.",
  "config": {"storeStageStatus": true},
  "trigger": {"type": "noOp", "config": {}, "output": ["relatedEntity", "updatedBy"]},
  "nodes": [
    {"type": "startEvent", "subType": "startEvent", "name": "TaskStart", "displayName": "Request created"},
    {"type": "userTask", "subType": "userApprovalTask", "name": "OpenReview", "displayName": "[Open] Awaiting reviewer decision", "config": {"assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"}, "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "open", "stageDisplayName": "Open — awaiting reviewer decision", "taskStatus": "Open", "assigneeStrategy": "reviewers", "transitionMetadata": [{"id": "approve", "label": "Approve", "targetStageId": "approved", "targetTaskStatus": "Approved", "formRef": "approve", "requiresComment": false}, {"id": "reject", "label": "Reject", "targetStageId": "rejected", "targetTaskStatus": "Rejected", "resolutionType": "Rejected", "formRef": "reject", "requiresComment": true}]}},
    {"type": "userTask", "subType": "userApprovalTask", "name": "ApprovedPublication", "displayName": "[Approved] Recording Data Product", "config": {"assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"}, "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "approved", "stageDisplayName": "Approved — recording Data Product", "taskStatus": "Approved", "assigneeStrategy": "reviewers", "transitionMetadata": [{"id": "grant", "label": "Mark active", "targetStageId": "granted", "targetTaskStatus": "Granted", "formRef": "grant", "requiresComment": false}]}},
    {"type": "userTask", "subType": "userApprovalTask", "name": "GrantedPublication", "displayName": "[Granted] Data Product active", "config": {"assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"}, "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "granted", "stageDisplayName": "Granted — Data Product active", "taskStatus": "Granted", "assigneeStrategy": "reviewers", "transitionMetadata": [{"id": "revoke", "label": "Revoke", "targetStageId": "revoked", "targetTaskStatus": "Revoked", "resolutionType": "Revoked", "formRef": "revoke", "requiresComment": true}]}},
    {"type": "endEvent", "subType": "endEvent", "name": "RejectedEnd", "displayName": "[Rejected] Publication denied"},
    {"type": "endEvent", "subType": "endEvent", "name": "RevokedEnd", "displayName": "[Revoked] Data Product removed"}
  ],
  "edges": [{"from": "TaskStart", "to": "OpenReview"}, {"from": "OpenReview", "to": "ApprovedPublication", "condition": "approve"}, {"from": "OpenReview", "to": "RejectedEnd", "condition": "reject"}, {"from": "ApprovedPublication", "to": "GrantedPublication", "condition": "grant"}, {"from": "GrantedPublication", "to": "RevokedEnd", "condition": "revoke"}]
}
