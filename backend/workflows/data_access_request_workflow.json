{
  "name": "DataAccessRequestTaskWorkflow",
  "displayName": "Data Access Request Workflow",
  "description": "Data-access lifecycle: a task reviewer approves or rejects a pending request. On approval the portal records Approved, provisions Oracle access, and advances to Granted; provisioning errors end Failed. Granted access can expire automatically or be revoked directly by an administrator. Diagram node labels intentionally include the OpenMetadata task status.",
  "config": {"storeStageStatus": true},
  "trigger": {"type": "noOp", "config": {}, "output": ["relatedEntity", "updatedBy"]},
  "nodes": [
    {"type": "startEvent", "subType": "startEvent", "name": "TaskStart", "displayName": "Request created"},
    {
      "type": "userTask", "subType": "userApprovalTask", "name": "PendingReview", "displayName": "[Pending] Awaiting reviewer decision",
      "config": {
        "assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"},
        "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "pending", "stageDisplayName": "Pending — awaiting reviewer decision", "taskStatus": "Pending", "assigneeStrategy": "reviewers",
        "transitionMetadata": [
          {"id": "approve", "label": "Approve", "targetStageId": "approved", "targetTaskStatus": "Approved", "formRef": "approve", "requiresComment": false},
          {"id": "reject", "label": "Reject", "targetStageId": "rejected", "targetTaskStatus": "Rejected", "resolutionType": "Rejected", "formRef": "reject", "requiresComment": true},
          {"id": "cancel", "label": "Cancel", "targetStageId": "cancelled", "targetTaskStatus": "Cancelled", "resolutionType": "Cancelled", "formRef": "cancel", "requiresComment": true}
        ]
      },
      "inputNamespaceMap": {"relatedEntity": "global"}
    },
    {
      "type": "userTask", "subType": "userApprovalTask", "name": "ApprovedProvisioning", "displayName": "[Approved] Provisioning Oracle access",
      "config": {
        "assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"},
        "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "approved", "stageDisplayName": "Approved — provisioning access", "taskStatus": "Approved", "assigneeStrategy": "reviewers",
        "transitionMetadata": [
          {"id": "grant", "label": "Provisioned", "targetStageId": "granted", "targetTaskStatus": "Granted", "formRef": "grant", "requiresComment": false},
          {"id": "fail", "label": "Provisioning failed", "targetStageId": "failed", "targetTaskStatus": "Failed", "resolutionType": "TimedOut", "formRef": "fail", "requiresComment": true}
        ]
      },
      "inputNamespaceMap": {"relatedEntity": "global"}
    },
    {
      "type": "userTask", "subType": "userApprovalTask", "name": "GrantedAccess", "displayName": "[Granted] Access active",
      "config": {
        "assignees": {"addReviewers": true, "addOwners": false, "candidates": [], "emptyAssigneeStrategy": "assignAdmins"},
        "approvalThreshold": 1, "rejectionThreshold": 1, "stageId": "granted", "stageDisplayName": "Granted — access active", "taskStatus": "Granted", "assigneeStrategy": "reviewers",
        "expiryTimer": {"dateVariable": "taskPayloadExpirationDate", "transitionId": "expire", "closeAsResolution": "Expired"},
        "transitionMetadata": [
          {"id": "revoke", "label": "Revoke", "targetStageId": "revoked", "targetTaskStatus": "Revoked", "resolutionType": "Revoked", "formRef": "revoke", "requiresComment": true},
          {"id": "expire", "label": "Expire", "targetStageId": "expired", "targetTaskStatus": "Expired", "resolutionType": "Expired", "formRef": "expire", "requiresComment": false}
        ]
      },
      "inputNamespaceMap": {"relatedEntity": "global"}
    },
    {"type": "endEvent", "subType": "endEvent", "name": "RejectedEnd", "displayName": "[Rejected] Request denied"},
    {"type": "endEvent", "subType": "endEvent", "name": "CancelledEnd", "displayName": "[Cancelled] Request cancelled"},
    {"type": "endEvent", "subType": "endEvent", "name": "FailedEnd", "displayName": "[Failed] Oracle provisioning failed"},
    {"type": "endEvent", "subType": "endEvent", "name": "RevokedEnd", "displayName": "[Revoked] Access removed"},
    {"type": "endEvent", "subType": "endEvent", "name": "ExpiredEnd", "displayName": "[Expired] Access expired"}
  ],
  "edges": [
    {"from": "TaskStart", "to": "PendingReview"},
    {"from": "PendingReview", "to": "ApprovedProvisioning", "condition": "approve"},
    {"from": "PendingReview", "to": "RejectedEnd", "condition": "reject"},
    {"from": "PendingReview", "to": "CancelledEnd", "condition": "cancel"},
    {"from": "ApprovedProvisioning", "to": "GrantedAccess", "condition": "grant"},
    {"from": "ApprovedProvisioning", "to": "FailedEnd", "condition": "fail"},
    {"from": "GrantedAccess", "to": "RevokedEnd", "condition": "revoke"},
    {"from": "GrantedAccess", "to": "ExpiredEnd", "condition": "expire"}
  ]
}
