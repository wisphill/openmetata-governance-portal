APP_ENV=development
PORTAL_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=portal-client-id
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Show Google/IdP account chooser on every portal sign-in. Set `login` to force
# re-authentication, or leave empty only when silent SSO is desired.
OIDC_LOGIN_PROMPT=select_account
# Google: normally use the same value as OIDC_CLIENT_ID. Leave blank to default to OIDC_CLIENT_ID.
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_LOGOUT_URI=http://localhost:5173
OIDC_EMAIL_CLAIM=email
# Used only when OPENMETADATA_USER_LOOKUP_FIELD=name. If this claim is absent,
# the backend falls back to the part before @ in OIDC_EMAIL_CLAIM.
OIDC_USERNAME_CLAIM=preferred_username
OPENMETADATA_BASE_URL=https://openmetadata.example.com
OM_ADMIN_BOT_TOKEN=replace-with-an-openmetadata-admin-bot-token
OPENMETADATA_API_VERSION=v1
OPENMETADATA_AUTH_MODE=admin_bot
OPENMETADATA_USER_LOOKUP_FIELD=email
OPENMETADATA_USER_LOOKUP_PAGE_SIZE=100
OPENMETADATA_USER_LOOKUP_MAX_PAGES=100
OPENMETADATA_TASKS_PATH=/tasks
OPENMETADATA_TASK_SCAN_MAX_PAGES=100
# Verify these two values against the installed OpenMetadata version. The default
# uses the v1 Task endpoint with OpenMetadata's DataAccessRequest task type.
OPENMETADATA_ACCESS_REQUEST_TASK_PATH=/tasks
OPENMETADATA_ACCESS_REQUEST_TASK_TYPE=DataAccessRequest
OPENMETADATA_ACCESS_REQUEST_EXPIRATION_DAYS=30
OPENMETADATA_CATALOG_PAGE_SIZE=20
OPENMETADATA_TIMEOUT_SECONDS=10
DATABASE_QUERIES_ENABLED=false
# Oracle Easy Connect, e.g. host:port/service_name; this is not an HTTP URL.
ORACLE_DSN=localhost:1521/freepdb1
# This principal needs CREATE USER, ALTER USER, GRANT CREATE SESSION, and
# GRANT SELECT on the application tables. It creates durable quoted users named
# om::<OpenMetadata UUID>; Oracle 12.2+ extended identifiers are required.
ORACLE_PROVISIONER_USER=
ORACLE_PROVISIONER_PASSWORD=
ORACLE_PROXY_USER=
ORACLE_PROXY_PASSWORD=
ORACLE_USER_ALLOWLIST=
ORACLE_QUERY_SCHEMA=
ORACLE_QUERY_TABLE=
ORACLE_QUERY_MAX_ROWS=
