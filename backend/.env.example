APP_ENV=development
PORTAL_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=portal-client-id
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Show Google/IdP account chooser on every portal sign-in. Set `login` to force
# re-authentication, or leave empty only when silent SSO is desired.
OIDC_LOGIN_PROMPT=select_account
# Google: normally use the same value as OIDC_CLIENT_ID. Leave blank to default to OIDC_CLIENT_ID.
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_LOGOUT_URI=http://localhost:5173
OIDC_EMAIL_CLAIM=email
OPENMETADATA_BASE_URL=https://openmetadata.example.com
OM_ADMIN_BOT_TOKEN=replace-with-an-openmetadata-admin-bot-token
OPENMETADATA_API_VERSION=v1
OPENMETADATA_AUTH_MODE=admin_bot
OPENMETADATA_USER_LOOKUP_FIELD=email
OPENMETADATA_USER_LOOKUP_PAGE_SIZE=100
OPENMETADATA_USER_LOOKUP_MAX_PAGES=100
OPENMETADATA_TASKS_PATH=/feed
OPENMETADATA_TIMEOUT_SECONDS=10
DATABASE_QUERIES_ENABLED=false
ORACLE_DSN=
ORACLE_PROXY_USER=
ORACLE_PROXY_PASSWORD=
ORACLE_USER_ALLOWLIST=
